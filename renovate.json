{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "rebaseWhen": "behind-base-branch",
  "tekton": {
    "schedule": ["* * * * *"],
    "managerFilePatterns": ["/\\.yaml$/", "/\\.yml$/"],
    "ignorePaths": [],
    "includePaths": [
      ".tekton/**",
      "integration-tests/**",
      "tasks/**",
      "pipelines/**"
    ],
    "pinDigests": true,
    "packageRules": [
      {
        "matchPackageNames": ["*"],
        "enabled": false
      },
      {
        "matchPackageNames": ["quay.io/konflux-ci/release-service-utils"],
        "groupName": "release-service-utils",
        "enabled": true,
        "pinDigests": true,
        "followTag": "latest"
      },
      {
        "matchPackageNames": ["quay.io/conforma/cli"],
        "groupName": "conforma-cli",
        "enabled": true,
        "pinDigests": true,
        "followTag": "latest"
      }
    ]
  }
}
