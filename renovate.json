{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["tekton"],
  "branchConcurrentLimit": 200,
  "prConcurrentLimit": 300,
  "prHourlyLimit": 200,
  "tekton": {
    "schedule": ["* 0 * * *"],
    "managerFilePatterns": ["/\\.yaml$/", "/\\.yml$/"],
    "packageRules": [
      {
        "matchDepTypes": ["tekton-step-image"],
        "enabled": false
      },
      {
        "description": "Enable utils image updates for tekton tasks",
        "matchDepTypes": ["tekton-step-image"],
        "matchPackageNames": [
          "quay.io/konflux-ci/release-service-utils",
          "quay.io/conforma/cli",
          "quay.io/konflux-ci/appstudio-utils",
          "quay.io/konflux-ci/charon",
          "amazon/aws-cli"
        ],
        "matchFileNames": [
          "tasks/managed/**",
          "tasks/internal/**",
          "tasks/collectors/**"
        ],
        "additionalBranchPrefix": "{{{ replace '(/tests.*)?$' '' packageFileDir }}}/",
        "commitMessageTopic": "utils image in {{{ replace '(/tests.*)?$' '' packageFileDir }}}",
        "enabled": true
      }
    ]
  }
}
