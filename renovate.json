{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "branchConcurrentLimit": 20,
  "prConcurrentLimit": 30,
  "prHourlyLimit": 20,
  "tekton": {
    "managerFilePatterns": [
      "/\\.yaml$/",
      "/\\.yml$/"
    ],
    "schedule": ["* 0 * * *"],
    "packageRules": [
      {
        "matchDepTypes": ["tekton-step-image"],
        "enabled": false
      },
      {
        "description": "Enable image updates for tekton tasks",
        "matchDepTypes": ["tekton-step-image"],
        "matchPackageNames": ["quay.io/konflux-ci/release-service-utils"],
        "matchFileNames": [
          "tasks/managed/*/**",
          "tasks/internal/*/**",
          "tasks/collectors/*/**"
        ],
        "additionalBranchPrefix": "{{{ replace '(/tests.*)?$' '' packageFileDir }}}/",
        "enabled": true,
        "prPriority": 10
      }
    ]
  }
}
