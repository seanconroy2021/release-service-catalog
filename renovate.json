{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["tekton", "kubernetes", "regex"],
  "branchConcurrentLimit": 200,
  "prConcurrentLimit": 300,
  "prHourlyLimit": 200,
  "tekton": {
    "schedule": ["* 0 * * *"],
    "managerFilePatterns": ["/\\.yaml$/", "/\\.yml$/"],
    "packageRules": [
      {
        "matchDepTypes": ["tekton-step-image"],
        "enabled": false
      },
      {
        "description": "Enable utils image updates for tekton tasks",
        "matchDepTypes": ["tekton-step-image"],
        "matchPackageNames": [
          "quay.io/konflux-ci/release-service-utils",
          "quay.io/conforma/cli",
          "quay.io/konflux-ci/appstudio-utils",
          "quay.io/konflux-ci/charon",
          "amazon/aws-cli"
        ],
        "matchFileNames": [
          "tasks/managed/**",
          "tasks/internal/**",
          "tasks/collectors/**"
        ],
        "enabled": true
      }
    ]
  },
  "kubernetes": {
    "packageRules": [
      {
        "description": "Update build-trusted-artifacts image in StepActions",
        "matchPackageNames": ["quay.io/redhat-appstudio/build-trusted-artifacts"],
        "matchFileNames": ["stepactions/**/*.yaml"],
        "enabled": true
      }
    ]
  },
  "regexManagers": [
    {
      "description": "Update build-trusted-artifacts image in StepActions using regex",
      "fileMatch": ["^stepactions/.*\\.yaml$"],
      "matchStrings": [
        "image:\\s+(?<depName>quay\\.io/redhat-appstudio/build-trusted-artifacts)@sha256:(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}
