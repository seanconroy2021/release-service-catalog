{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "branchConcurrentLimit": 20,
  "prConcurrentLimit": 30,
  "prHourlyLimit": 20,
  "tekton": {
    "managerFilePatterns": [
      "/\\.yaml$/",
      "/\\.yml$/"
    ],
    "schedule": ["* 0 * * *"],
    "packageRules": [
      {
        "matchDepTypes": ["tekton-step-image"],
        "enabled": false
      },
      {
        "matchDepTypes": ["tekton-step-image"],
        "matchPackageNames": [
          "quay.io/konflux-ci/release-service-utils"
        ],
        "enabled": true,
        "groupName": "release-service-utils Tekton images",
        "prPriority": 10
      }
    ]
  }
}
